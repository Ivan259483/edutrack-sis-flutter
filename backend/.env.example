# Copy to .env and fill in. Never commit the real .env.
PORT=5001
NODE_ENV=development
# At least 32 random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
MONGO_URI=mongodb://127.0.0.1:27017/edutrack
# Frontends allowed by CORS (student portal, admin portal)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
# Gmail address + 16-character App Password for verification emails.
# Leave empty in development: codes are printed in the backend console instead.
EMAIL_USER=
EMAIL_PASS=
# Optional, only read by `npm run seed`: admin password for the seeded account.
# Use a strong one for any online database (default: Admin123! for local demos).
SEED_ADMIN_PASSWORD=
